# 跨编辑器统一缩进与行尾。
# 与 .gitattributes（eol=lf）配套：一个管 git 落盘，一个管编辑器写入。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是"硬换行"，不能自动删
trim_trailing_whitespace = false

[*.{tex,bib}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
