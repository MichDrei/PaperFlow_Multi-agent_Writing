{
  "name": "paperflow",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-LLM collaborative scientific paper writing platform (Overleaf + Cursor + multi-agent group chat)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev -w @paperflow/web",
    "dev:server": "npm run dev -w @paperflow/server",
    "build": "npm run build -w @paperflow/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:ui": "bash scripts/verify-ui.sh",
    "check:models": "tsx scripts/check-models.mts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules dist artifacts",
    "postinstall": "node scripts/setup-pdfjs-assets.mjs",
    "setup:pdfjs": "node scripts/setup-pdfjs-assets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  }
}
