# PaperFlow 编排服务环境变量
#
#   cp apps/server/.env.example apps/server/.env
#
# ⚠️ 最重要的规则：本文件里所有示例行都以 `#` 开头（= 注释 = 程序读不到）。
#    你必须**删掉行首的 #**，或者干脆追加到文件末尾。写在注释里的 Key 不会报错，
#    只会静默降级到本地回退 —— 这是最常见的"我明明配了却没生效"。
#
# ✅ 最省事的做法：直接在文件末尾追加两行（没有 # 要管）
#       DEEPSEEK_API_KEY=sk-你的真实key
#       QWEN_API_KEY=sk-你的真实key
#
# 全部留空也能启动：会自动降级到本地回退引擎（功能完整，只是不调用真实模型）。
#
# 填好后运行 `npm run check:models` 自检：它会打印读到的配置文件路径、
# 指出被注释掉的 Key 行号，并真的打一次最小请求确认 Key/地址/模型名都对。

PORT=8787
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5273,http://localhost:5273

# 单回合最多并发几个模型（防止 @all 打爆配额）
MAX_CONCURRENCY=4
# 是否让第二个模型对第一个模型的产出发起交叉评审
ENABLE_CROSS_REVIEW=true

# ============================================================================
# DeepSeek  https://platform.deepseek.com   —— 约 1 分钟配好，最省事
# ============================================================================
# 1) 控制台创建 API Key（sk- 开头）
# 2) 取消下面两行注释即可，默认地址与模型名都已对齐官方文档，无需改动
#
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# 可选：默认模型是 deepseek-chat（V3，通用写作/改写）与 deepseek-reasoner（R1，推理）
# 若账号只开通了其中一个，用下面这行只保留可用的，避免轮询时报错：
# DEEPSEEK_MODELS=deepseek-chat
#
# 可选：走自建网关/MoonShot 兼容层时改地址（须以 /v1 结尾）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================================================
# Qwen（阿里云百炼 / DashScope）https://bailian.console.aliyun.com
# ============================================================================
# 1) 开通百炼并创建 API Key
# 2) 取消下面这行注释
#
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
#   ↑ 等价别名：DASHSCOPE_API_KEY=（阿里云官方文档里用的就是这个名字，两者都认）
#
# ⚠️ 三个最容易踩的坑：
#   a) **Key 与地域绑定**。用北京的 Key 调新加坡端点会返回
#      401 `Incorrect API key provided` / `invalid_api_key`，这不是 Key 无效，
#      是地域不匹配。请让 Key 与 BaseURL 属于同一地域。
#   b) **模型名会变**。默认给的是稳定存在的 `qwen-plus` / `qwen-max`；
#      要换新模型（如 qwen3.8-max、qwen3-vl-* 等）请用 QWEN_MODELS 覆盖，
#      不要让平台静默降级。
#   c) **只有 messages[0] 支持 system 角色**。本平台的上下文序列化已符合该约束，
#      自行改造 serializer 时注意别把 system 放到中间。
#
# 可选：换成新版工作空间域名（阿里云推荐，需替换 {WorkspaceId}）
#   北京   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   新加坡 https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   香港   https://{WorkspaceId}.cn-hongkong.maas.aliyuncs.com/compatible-mode/v1
#   美西   https://dashscope-us.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 可选：只保留你账号实际开通的模型（逗号分隔），会同步出现在前端阵容里
# QWEN_MODELS=qwen-plus,qwen-max

# ============================================================================
# Kimi（Moonshot）https://platform.kimi.com  —— 有原生视觉，能直接看 PDF 页面图
# ============================================================================
# 1) 在开放平台创建 API Key（sk- 开头）
# 2) 取消下面这行注释即可。base_url 与官方文档一致，无需改动
#
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ⚠️ 模型名会**下线**，这是最容易踩的坑：kimi-k2 系列已于 2026-05-25 下线、
#    moonshot-v1 系列已于 2026-08-31 下线。用旧名字会直接报"模型不存在"。
#    当前可用（2026-09 核对）：
#      kimi-k3                  旗舰，100 万 token 上下文，原生视觉
#      kimi-k2.6                256k 上下文，支持视觉
#      kimi-k2.7-code           编程向
#      kimi-k2.7-code-highspeed 编程向高速版
# 默认配置为 kimi-k2.6（更普遍可用）与 kimi-k3（旗舰，可能是申请制）。
# ⚠️ 但**不要靠猜**：直接问接口你这个账号到底能用什么
#     npm run check:models -- --discover
#   它会调用 GET /models 列出账号真实可用的模型（实测有的账号看不到 kimi-k3）。
# 确认后用下面这行覆盖（逗号分隔）：
# MOONSHOT_MODELS=kimi-k2.6
#
# 另外注意 Kimi 的**限流比较紧**（实测新账号 3 请求/分钟）：
# 别把它放进 @all 的默认阵容，否则一轮就会打到 429。单独 @ 使用即可。
#
# 可选：国际站/代理地址
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ============================================================================
# 其他厂商（同样按需填写）
# ============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODELS=claude-sonnet-4
# OPENAI_API_KEY=sk-...
# OPENAI_MODELS=gpt-4o
# GOOGLE_API_KEY=...              # 或 GEMINI_API_KEY
# GOOGLE_MODELS=gemini-2.5-pro
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODELS=anthropic/claude-sonnet-4,google/gemini-2.5-pro

# 本地推理（Ollama / vLLM / SGLang）—— 不需要 Key，必须显式声明地址才算启用
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODELS=qwen3:32b,llama3.3:70b

# 所有厂商都可用 <PROVIDER>_BASE_URL 指向代理 / 自建 LiteLLM 网关
# OPENAI_BASE_URL=https://your-gateway/v1
# ANTHROPIC_BASE_URL=https://your-gateway

# ============================================================================
# LaTeX 编译
# ============================================================================
# 不设置则使用内置 MockCompiler（纯 JS 排版，能出真实 PDF 与源码锚点）
# LATEX_COMPILER_URL=http://127.0.0.1:8788

LOG_LEVEL=info
