# ---- 模型厂商（至少配一个） ----
# 个人使用：只配你自己的 key 即可
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=

# ---- 运行模式 ----
# 不设置 = 单人模式（本地写作工具，无需登录）
# team   = 团队协作模式（邀请链接 → 申请 → 发起方审批）
# AUTH_MODE=team

# ---- 服务 ----
PORT=5273
HOST=127.0.0.1
LOG_LEVEL=info
MAX_CONCURRENCY=4
ENABLE_CROSS_REVIEW=true

# ---- 数据目录（默认 <仓库>/.paperflow） ----
# PROJECTS_ROOT=/srv/paperflow-data
